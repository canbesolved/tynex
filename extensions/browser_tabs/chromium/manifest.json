{
  "manifest_version": 3,
  "name": "tynex",
  "version": "0.3.0",
  "description": "Search and switch open tabs from tynex.",
  "key": "",
  "permissions": ["tabs", "nativeMessaging", "alarms", "favicon"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "tynex",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
